  "gim-gu": [
    { "level": 1, "text": "일제강점기에 주로 국외에서 활동한 독립운동가다.", "source": { "title": "한국민족문화대백과사전 '김구'", "url": "https://encykorea.aks.ac.kr/Article/E0008753" } },
    { "level": 2, "text": "대한민국 임시정부에 참여해 광복 때까지 활동했고, 광복 후 귀국해 정치 활동을 이어 갔다.", "source": { "title": "한국민족문화대백과사전 '김구'", "url": "https://encykorea.aks.ac.kr/Article/E0008753" } },
    { "level": 3, "text": "광복 후 남한만의 단독 정부 수립에 반대하며 1948년 남북 협상에 참석했다.", "source": { "title": "한국민족문화대백과사전 '김구'", "url": "https://encykorea.aks.ac.kr/Article/E0008753" } },
    { "level": 4, "text": "임시정부에서 경무국장을 거쳐 주석에 올랐고, 1940년 한국광복군 창설을 이끌었다.", "source": { "title": "한국민족문화대백과사전 '김구'", "url": "https://encykorea.aks.ac.kr/Article/E0008753" } },
    { "level": 5, "text": "1931년 한인애국단을 조직해 이봉창·윤봉길의 의거를 이끌었다.", "source": { "title": "한국민족문화대백과사전 '김구'", "url": "https://encykorea.aks.ac.kr/Article/E0008753" } }
