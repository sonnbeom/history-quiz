  "joseon-gojong": [
    { "level": 1, "text": "왕실 종친 집안에서 태어나, 19세기 후반 조선 정치의 중심에 섰던 인물이다.", "source": { "title": "한국민족문화대백과사전 '고종'", "url": "https://encykorea.aks.ac.kr/Article/E0003939" } },
    { "level": 2, "text": "병인양요와 신미양요처럼 서양 세력과 무력으로 맞부딪치던 시기에 이미 나라 정치의 중심에 있었다.", "source": { "title": "한국민족문화대백과사전 '이하응'", "url": "https://encykorea.aks.ac.kr/Article/E0046384" } },
    { "level": 3, "text": "어린 나이에 왕위에 올라 즉위 초에는 아버지가 실권을 쥐고 정치를 이끌었다. 뒤에 한때 러시아 공사관으로 거처를 옮겼다가 이듬해 궁궐로 돌아왔다.", "source": { "title": "한국민족문화대백과사전 '고종'", "url": "https://encykorea.aks.ac.kr/Article/E0003939" } },
    { "level": 4, "text": "1899년 황제 직속의 최고 군 통수 기관인 원수부를 두어 군대를 직접 장악했다.", "source": { "title": "한국민족문화대백과사전 '원수부'", "url": "https://encykorea.aks.ac.kr/Article/E0040727" } },
    { "level": 5, "text": "1897년 대한제국을 선포하고 황제로 즉위했으며, 1907년 헤이그 특사 파견을 구실로 강제 퇴위되었다.", "source": { "title": "한국민족문화대백과사전 '고종'", "url": "https://encykorea.aks.ac.kr/Article/E0003939" } }
  ],
  "jang-bo-go": [
    { "level": 1, "text": "신라 하대에 활동한 인물이다.", "source": { "title": "한국민족문화대백과사전 '장보고'", "url": "https://encykorea.aks.ac.kr/Article/E0048474" } },
    { "level": 2, "text": "젊어서 당으로 건너가 군인으로 활약한 뒤 신라로 돌아왔다.", "source": { "title": "한국민족문화대백과사전 '장보고'", "url": "https://encykorea.aks.ac.kr/Article/E0048474" } },
    { "level": 3, "text": "당의 산둥 지방에 신라인을 위한 절인 법화원을 세웠다.", "source": { "title": "한국민족문화대백과사전 '장보고'", "url": "https://encykorea.aks.ac.kr/Article/E0048474" } },
    { "level": 4, "text": "왕위 계승 다툼에 개입해 신무왕의 즉위를 도왔으나, 뒤에 자객에게 암살당했다.", "source": { "title": "한국민족문화대백과사전 '장보고'", "url": "https://encykorea.aks.ac.kr/Article/E0048474" } },
    { "level": 5, "text": "828년 완도에 청해진을 설치해 해적을 소탕하고, 신라·당·일본을 잇는 해상 무역을 주도했다.", "source": { "title": "한국민족문화대백과사전 '장보고'", "url": "https://encykorea.aks.ac.kr/Article/E0048474" } }
  ],
  "gwanggaeto": [
    { "level": 1, "text": "삼국 시대 고구려의 왕이다.", "source": { "title": "한국민족문화대백과사전 '광개토왕'", "url": "https://encykorea.aks.ac.kr/Article/E0005057" } },
    { "level": 2, "text": "활발한 정복 활동으로 나라의 영토를 크게 넓혔다.", "source": { "title": "한국민족문화대백과사전 '광개토왕'", "url": "https://encykorea.aks.ac.kr/Article/E0005057" } },
    { "level": 3, "text": "백제를 공격해 한강 이북의 여러 성을 빼앗았고, 후연과 거란 등을 정벌해 영토를 크게 넓혔다.", "source": { "title": "한국민족문화대백과사전 '광개토왕'", "url": "https://encykorea.aks.ac.kr/Article/E0005057" } },
    { "level": 4, "text": "4세기 말에 즉위해 5세기 초까지 다스렸으며, 신라의 요청을 받고 군대를 보내 신라에 침입한 왜군을 물리쳤다.", "source": { "title": "한국민족문화대백과사전 '광개토왕'", "url": "https://encykorea.aks.ac.kr/Article/E0005057" } },
    { "level": 5, "text": "'영락'이라는 독자적인 연호를 썼다. 그 정복 업적은 아들인 다음 왕이 414년에 세운 거대한 비석에 새겨졌다.", "source": { "title": "한국민족문화대백과사전 '광개토왕릉비'", "url": "https://encykorea.aks.ac.kr/Article/E0005058" } }
  ],
  "gim-jeong-hui": [
    { "level": 1, "text": "조선 후기에 활동한 학자이자 문인이다.", "source": { "title": "한국민족문화대백과사전 '김정희'", "url": "https://encykorea.aks.ac.kr/Article/E0010428" } },
    { "level": 2, "text": "청나라 학문을 적극 받아들여, 사실에 근거해 진리를 찾는 실사구시를 강조했다.", "source": { "title": "한국민족문화대백과사전 '김정희'", "url": "https://encykorea.aks.ac.kr/Article/E0010428" } },
    { "level": 3, "text": "고증학과 함께 옛 비석과 금석문을 연구하는 금석학에 힘썼다.", "source": { "title": "한국민족문화대백과사전 '김정희'", "url": "https://encykorea.aks.ac.kr/Article/E0010428" } },
    { "level": 4, "text": "북한산의 옛 비석을 조사해 그것이 신라 진흥왕의 순수비임을 밝혀냈다.", "source": { "title": "한국민족문화대백과사전 '서울 북한산 신라 진흥왕 순수비'", "url": "https://encykorea.aks.ac.kr/Article/E0024795" } },
    { "level": 5, "text": "독창적인 서체를 완성했고, 제주도 유배 시절에 「세한도」를 그렸다.", "source": { "title": "한국민족문화대백과사전 '김정희'", "url": "https://encykorea.aks.ac.kr/Article/E0010428" } }
  ]
