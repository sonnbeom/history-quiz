  "yeongjo": [
    { "level": 1, "text": "붕당 정치가 이어지던 조선 후기의 국왕이다.", "source": { "title": "한국민족문화대백과사전 '영조'", "url": "https://encykorea.aks.ac.kr/Article/E0037669" } },
    { "level": 2, "text": "붕당 간 다툼을 누그러뜨리기 위해 여러 붕당의 인재를 고르게 쓰는 탕평 정치를 폈다.", "source": { "title": "한국민족문화대백과사전 '영조'", "url": "https://encykorea.aks.ac.kr/Article/E0037669" } },
    { "level": 3, "text": "즉위 초에 왕위 계승의 정통성을 문제 삼은 이인좌의 난을 진압했고, 뒤에는 도성 안 개천 바닥을 파내는 준천 사업을 벌였다.", "source": { "title": "한국민족문화대백과사전 '영조'", "url": "https://encykorea.aks.ac.kr/Article/E0037669" } },
    { "level": 4, "text": "1742년 성균관 앞에 탕평비를 세워 탕평의 뜻을 널리 알렸다.", "source": { "title": "한국민족문화대백과사전 '탕평비'", "url": "https://encykorea.aks.ac.kr/Article/E0058858" } },
    { "level": 5, "text": "백성의 군역 부담을 덜기 위해 해마다 내던 군포를 2필에서 1필로 줄이는 균역법을 시행했다.", "source": { "title": "한국민족문화대백과사전 '영조'", "url": "https://encykorea.aks.ac.kr/Article/E0037669" } }
  ],
  "yi-seong-gye": [
    { "level": 1, "text": "고려 말에 활동한 무장이다.", "source": { "title": "한국민족문화대백과사전 '태조(조선)'", "url": "https://encykorea.aks.ac.kr/Article/E0059033" } },
    { "level": 2, "text": "여러 차례 왜구의 침입을 물리쳐 이름을 떨쳤다.", "source": { "title": "한국민족문화대백과사전 '태조(조선)'", "url": "https://encykorea.aks.ac.kr/Article/E0059033" } },
    { "level": 3, "text": "1362년 홍건적에게 빼앗겼던 개경을 되찾는 싸움에 참여했다.", "source": { "title": "한국민족문화대백과사전 '태조(조선)'", "url": "https://encykorea.aks.ac.kr/Article/E0059033" } },
    { "level": 4, "text": "1388년 명의 요동을 치러 나선 정벌군에서 지휘를 맡았다.", "source": { "title": "한국민족문화대백과사전 '태조(조선)'", "url": "https://encykorea.aks.ac.kr/Article/E0059033" } },
    { "level": 5, "text": "요동으로 가던 중 위화도에서 군대를 되돌려 정권을 잡았고, 신진 사대부의 지지를 받아 1392년 새 왕조의 첫 국왕이 되었다.", "source": { "title": "한국민족문화대백과사전 '태조(조선)'", "url": "https://encykorea.aks.ac.kr/Article/E0059033" } }
