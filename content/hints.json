{
  "bak-jeong-hui": [
    { "level": 1, "text": "광복 이후 대한민국에서 활동한 정치인으로, 대통령을 지냈다.", "source": { "title": "한국민족문화대백과사전 '박정희'", "url": "https://encykorea.aks.ac.kr/Article/E0021134" } },
    { "level": 2, "text": "군인 출신으로, 정변을 일으켜 정권을 잡은 뒤 대통령에 올랐다.", "source": { "title": "한국민족문화대백과사전 '박정희'", "url": "https://encykorea.aks.ac.kr/Article/E0021134" } },
    { "level": 3, "text": "재임 중 일본과 협정을 맺어 국교를 정상화했고, 베트남에 국군을 파병했다.", "source": { "title": "한국민족문화대백과사전 '박정희'", "url": "https://encykorea.aks.ac.kr/Article/E0021134" } },
    { "level": 4, "text": "경제 개발 5개년 계획을 추진해 산업화를 이끌었고, 그 계획 기간에 경부 고속도로를 놓았다.", "source": { "title": "한국민족문화대백과사전 '경부고속도로'", "url": "https://encykorea.aks.ac.kr/Article/E0002460" } },
    { "level": 5, "text": "5·16 군사 정변으로 집권했으며, 유신 체제를 수립해 장기 집권의 길을 열었다.", "source": { "title": "한국민족문화대백과사전 '박정희'", "url": "https://encykorea.aks.ac.kr/Article/E0021134" } }
  ],
  "wang-geon": [
    { "level": 1, "text": "신라 말 혼란기에 지방 세력을 바탕으로 일어나 새 나라를 세운 인물이다.", "source": { "title": "한국민족문화대백과사전 '태조(고려)'", "url": "https://encykorea.aks.ac.kr/Article/E0059032" } },
    { "level": 2, "text": "지방 호족 집안 출신으로, 처음에는 다른 군주 밑에서 장수로 활약했다.", "source": { "title": "한국민족문화대백과사전 '태조(고려)'", "url": "https://encykorea.aks.ac.kr/Article/E0059032" } },
    { "level": 3, "text": "지방 호족을 끌어안기 위해 여러 호족 집안과 혼인 관계를 맺고, 공을 세운 사람들에게 역분전을 나누어 주었다.", "source": { "title": "한국민족문화대백과사전 '태조(고려)'", "url": "https://encykorea.aks.ac.kr/Article/E0059032" } },
    { "level": 4, "text": "942년 거란이 보낸 사신을 섬으로 귀양 보내고, 함께 보내온 낙타 50필은 다리 아래에서 굶어 죽게 했다.", "source": { "title": "한국민족문화대백과사전 '만부교사건'", "url": "https://encykorea.aks.ac.kr/Article/E0017609" } },
    { "level": 5, "text": "918년 고려를 세우고 936년 후삼국을 통일했으며, 후대 왕들에게 훈요 10조를 남겼다.", "source": { "title": "한국민족문화대백과사전 '태조(고려)'", "url": "https://encykorea.aks.ac.kr/Article/E0059032" } }
